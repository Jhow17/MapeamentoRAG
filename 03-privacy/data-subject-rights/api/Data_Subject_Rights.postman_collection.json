            "body": {
              "mode": "raw",
              "raw": "{\n    \"publish_subject\": \"Confirmation Request Completed\",\n    \"publish_body\": \"<p><a href=\\\"https://www.googl.com\\\" rel=\\\"noopener noreferrer nofollow\\\" target=\\\"_blank\\\">nothing goes here</a><br><br><br></p>\",\n    \"override_default_message\": false,\n    \"consolidated_report\": true,\n    \"include_system_names\": true,\n    \"include_pd_names\": true,\n    \"include_pd_value\": true,\n    \"hide_process_info\": true,\n    \"skip_completion_notification\": false,\n    \"merge_pdf_files\": true,\n    \"hide_subtask_details\": true,\n    \"regenerate_report\": false,\n    \"email_subject\": \"DSR request complete. Download a copy of your report. hbhj\",\n    \"email_body\": \"<p>Hi {{.User}},</p><p>Thank you for your DSR {{.RequestType}}. We have processed and responded to your inquiry. We now consider this matter closed. making changes to see if they reflect in workbench--- ghhgjhgj{{.RequestType}}</p><p><strong>Request ID: {{.RequestID}}</strong></p><p><strong>Submitted: {{.RequestSubmissionDate}}</strong></p><p>You can download a copy of your report here.</p><p></p><p>{{.RequestType}}</p><p>{{.TenantName}}</p><p>{{.User}}</p><p><a href=\\\"{{.PortalLink}}\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\">View</a></p><p>Please do not hesitate to contact us if you have any further questions.</p><p>With kind regards</p><p>{{.TenantName}}</p>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{host-url}}/privaci/v1/admin/dsr/tickets/:id/publish",
              "host": [
                "{{host-url}}"
              ],
              "path": [
                "privaci",
                "v1",
                "admin",
                "dsr",
                "tickets",
                ":id",
                "publish"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "106418",
                  "description": "Specify the DSR id. You can fetch this id from the response of \"Fetching all DSR requests\" API."
                }
              ]
            },
            "description": "## Request body parameters\n\n| Parameter | Type | Description | Example |\n| --- | --- | --- | --- |\n| `publish_subject` | string | Specify the subject for publishing report. | `Request completed` |\n| `publish_body` | string | Specify the subject for publishing report. | `Thank you for your request` |\n| `override_default_message` | boolean | Type true for override default message and false not to. | `false` |\n| `consolidated_report` | boolean | Type true for consolidated report and false if not. | `true` |\n| `include_system_names` | boolean | Type true to include system names and false not to. | `false` |\n| `include_pd_names` | boolean | Type true include pd names and false not to. | `false` |\n| `include_pd_value` | boolean | Type true include pd values and false not to. | `true` |\n| `hide_process_info` | boolean | Type true to hide DSR process info and false not to. | `false` |\n| `skip_completion_notification` | boolean | Type true to skip email notification to Data Subject about the DSR completion and false not to. | `false` |\n| `merge_pdf_files` | boolean | Type true to merge all pdf files attached to a subtask and false not to. | `true` |\n| `hide_subtask_details` | boolean | Type true to hide subtask details from DSR report such as reason for declining any subtask and false not to. | `true` |\n| `regenerate_report` | boolean | Regenerate a new report and replace the existing one. This option is used only if you have already generated the DSR report. | `true` |\n| `email_subject` | string | Specify the subject of the email you need to send to the data subject informing them about the DSR completion | `DSR request complete. Download a copy of your report.` |\n| `email_body` | string | Specify the body of the email. You can also add bind variable in the email body. Fetch bind variables from the response of Fetch email to send to the data subject API. | `Your DSR request has been completed successfully.` |"
          },
