              "raw": "{\n    \"form_data\": \"{\\\"ticket_type\\\":[\\\"access\\\"],\\\"user_type\\\":\\\"customer\\\",\\\"email\\\":\\\"priya.patel@gmail.com\\\",\\\"account_email\\\":\\\"\\\",\\\"first_name\\\":\\\"john\\\",\\\"last_name\\\":\\\"doe\\\",\\\"dob\\\":\\\"\\\",\\\"phone\\\":\\\"3243-4343434\\\",\\\"street\\\":\\\"\\\",\\\"apt_no\\\":\\\"\\\",\\\"city\\\":\\\"\\\",\\\"state\\\":\\\"\\\",\\\"postal_code\\\":\\\"\\\",\\\"country\\\":\\\"\\\",\\\"requestSubject\\\":\\\"\\\",\\\"requestDetails\\\":\\\"\\\",\\\"attachments\\\":[],\\\"additionalCustomCheckbox\\\":false,\\\"submit\\\":true}\",\n    \"is_user_create_needed\": true,\n    \"form_uuid\": \"f7dc3dbd-d17e-4418-a91d-121f51653caa\",\n    \"user_timezone\": \"Asia/Karachi\",\n    \"created_date\": 1779299580000,\n    \"scope_metadata\": {\n        \"data_source_scopes\": {\n            \"958\": {\n                \"keywords\": [\n                    \"probation\",\n                    \"summers\"\n                ],\n                \"users\": [\n                    \"john.doe@gmail.com\"\n                ]\n            }\n        }\n    }\n}",
