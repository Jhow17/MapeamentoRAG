port.\",\n            \"preview\": \"\",\n            \"module\": \"dsr\",\n            \"is_published\": false,\n            \"is_draft\": false,\n            \"published_at\": 0,\n            \"has_subject_bind_vars\": false,\n            \"locale\": \"en-us\",\n            \"require_translation\": false,\n            \"tenant_logo\": null,\n            \"logo_file_path\": \"\"\n        },\n        {\n            \"created_by\": 0,\n            \"modified_by\": 0,\n            \"created_at\": 1737710961992,\n            \"modified_at\": 1737710961992,\n            \"tenant_id\": \"xxxx\",\n            \"id\": 57,\n            \"title\": \"DSR Appeal Request Received\",\n            \"description\": \"Securiti sends this email when DSR Appeal Request is being reviewed.\",\n            \"body\": \"<p>Hi {{.User}},</p><p>Thank you for your DSR Appeal Request. We are pleased to confirm the receipt of your inquiry, which we will review promptly and respond to within the legal time limits.</p><p><strong>Request ID: {{ .RequestID }}</strong></p><p><strong>Submitted: {{ .RequestSubmissionDate }}</strong></p><p>Log in to our <a href=\\\"{{ .PortalLink }}\\\">DSR Request Center</a> to access your report, make any changes to info provided in this request, contact the processor, or view any additional requests. <br/> Please do not hesitate to contact us if you have any further questions.</p><p>With kind regards</p><p>{{.TenantName}}</p>\",\n            \"used_for\": \"dsr.notify_appeal_received_via_mail\",\n            \"system\": true,\n            \"subject\": \"Your DSR Appeal Request Received\",\n            \"preview\": \"\",\n            \"module\": \"dsr\",\n            \"is_published\": false,\n            \"is_draft\": false,\n            \"published_at\": 0,\n            \"has_subject_bind_vars\": false,\n            \"locale\": \"en-us\",\n            \"require_translation\": false,\n            \"tenant_logo\": null,\n            \"logo_file_path\": \"\"\n        